#!/usr/bin/env bash

set -euo pipefail

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'
info()    { echo -e "${CYAN}[rencoder]${RESET} $*"; }
success() { echo -e "${GREEN}[rencoder]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[rencoder]${RESET} $*"; }
die()     { echo -e "${RED}[rencoder] ERROR:${RESET} $*" >&2; exit 1; }

echo ""
echo -e "${BOLD}  Remote Encoder Uninstall${RESET}"
echo ""

BELAUI_JS="/opt/belaUI/belaUI.js"
CONFIG_JSON="/opt/belaUI/config.json"
BACKUP="${BELAUI_JS}.rencoder.bak"
UPSTREAM="https://raw.githubusercontent.com/BELABOX/belaUI/refs/heads/ws_nodejs/belaUI.js"

[[ $EUID -eq 0 ]]   || die "Please run as root."
[[ -f "$BELAUI_JS" ]]   || die "belaUI.js not found — is this a Belabox?"

if [[ -f "$BACKUP" ]]; then
  info "Restoring belaUI.js from backup…"
  cp "$BACKUP" "$BELAUI_JS"
  rm "$BACKUP"
  success "belaUI.js restored."
else
  warn "No backup found — restoring clean copy from upstream…"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$UPSTREAM" -o "$BELAUI_JS" || {
      warn "Upstream restore failed — attempting in-place revert…"
      sed -i "s|rencoder\.provid\.gg|remote.belabox.net|g" "$BELAUI_JS"
      sed -i "s|'/ws/belaboxremote'|'/ws/remote'|g" "$BELAUI_JS"
      grep -q "remote.belabox.net" "$BELAUI_JS" && success "Reverted." || die "Revert failed — restore belaUI.js manually."
    }
    success "Restored from upstream."
  else
    warn "curl not available — attempting in-place revert…"
    sed -i "s|rencoder\.provid\.gg|remote.belabox.net|g" "$BELAUI_JS"
    sed -i "s|'/ws/belaboxremote'|'/ws/remote'|g" "$BELAUI_JS"
    grep -q "remote.belabox.net" "$BELAUI_JS" && success "Reverted." || die "Revert failed — restore belaUI.js manually."
  fi
fi

if [[ -f "$CONFIG_JSON" ]] && command -v python3 >/dev/null 2>&1; then
  info "Removing remote_key from config.json…"
  python3 - <<PYTHON
import json
with open("$CONFIG_JSON") as f: config = json.load(f)
config.pop("remote_key", None)
with open("$CONFIG_JSON", "w") as f: json.dump(config, f, indent=2); f.write("\n")
PYTHON
  success "remote_key removed."
fi

systemctl restart belaUI 2>/dev/null || true
( sleep 15 && reboot ) &>/dev/null & disown

echo ""
echo -e "${GREEN}${BOLD}  ✓ Remote Encoder uninstalled.${RESET}"
echo -e "  ${YELLOW}Rebooting in 15 seconds.${RESET}"
echo ""
